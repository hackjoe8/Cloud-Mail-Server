TZ=Asia/Shanghai

# SMTP inbound: production should use 25
SMTP_BIND_PORT=25
SMTP_SECURE_BIND_PORT=465

# Backend HTTP bind
API_BIND_PORT=8787

# Cloud Mail core
DOMAIN=["example.com"]
ADMIN=admin@example.com
JWT_SECRET=change-me-very-long
ORM_LOG=false

# PostgreSQL / Redis in Docker network (no host port mapping)
POSTGRES_DB=cloud_mail
POSTGRES_USER=cloud_mail
POSTGRES_PASSWORD=change-postgres-password
DATABASE_URL=postgres://cloud_mail:change-postgres-password@postgres:5432/cloud_mail
PG_SSL=false
PG_POOL_MAX=12
PG_POOL_MIN=0
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECT_TIMEOUT_MS=5000
PG_MAX_USES=7500
REDIS_URL=redis://redis:6379/0

# Scheduler
ENABLE_CRON=true
CRON_EXPR=0 0 * * *
CRON_TIMEZONE=Asia/Shanghai

# Optional OAuth
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_CALLBACK_URL=
LINUXDO_SWITCH=false

# MinIO / S3 (containerized in this compose)
S3_BUCKET=cloud-mail
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-minio-password

# SMTP server options
SMTP_REQUIRE_AUTH=false
SMTP_AUTH_USER=
SMTP_AUTH_PASS=
SMTP_ENABLE_STARTTLS=false
SMTP_ALLOW_INSECURE_AUTH=
SMTP_TLS_KEY_PATH=
SMTP_TLS_CERT_PATH=
SMTP_TLS_PFX_PATH=
SMTP_TLS_PFX_PASSPHRASE=
SMTP_SECURE_ENABLED=false
SMTP_SECURE_PORT=465
SMTP_MAX_SIZE=26214400
